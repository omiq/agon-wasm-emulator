+    /// One-time setup for cooperative stepping (browser/wasm hosts that can't
+    /// block in start()). Mirrors the init part of start().
+    pub fn prepare(&mut self, cpu: &mut Cpu) {
+        match self.ram_init {
+            RamInit::Random => {
+                for i in 0..self.mem_external.len() {
+                    self.mem_external[i as usize] = rand::thread_rng().gen_range(0..=255);
+                }
+                for i in 0..ONCHIP_RAM_SIZE {
+                    self.mem_internal[i as usize] = rand::thread_rng().gen_range(0..=255);
+                }
+            }
+            RamInit::Zero => {}
+        }
+        self.load_mos();
+        cpu.state.set_pc(0);
+    }
+
+    /// Run approximately `cycles` clock cycles, then return. Mirrors the
+    /// inner timeslice loop of start(), without debugger or sleeping.
+    pub fn run_cycles(&mut self, cpu: &mut Cpu, cycles: u64) {
+        let mut cycle: u64 = 0;
+        while cycle < cycles {
+            self.execute_instruction(cpu);
+            if cpu.is_halted() {
+                // a halted cpu consumes no cycles, which would freeze the
+                // timers and uarts and make wake-up impossible: advance
+                // emulated time manually while asleep
+                self.cycle_counter
+                    .set(self.cycle_counter.get() + self.interrupt_precision);
+            }
+            if self.cycle_counter.get() >= self.interrupt_precision {
+                cycle += self.apply_elapsed_cycles() as u64;
+                self.do_interrupts(cpu);
+            }
+        }
+        if self.soft_reset.load(std::sync::atomic::Ordering::Relaxed) {
+            cpu.state.reg.adl = true;
+            cpu.state.set_pc(0);
+            self.soft_reset
+                .store(false, std::sync::atomic::Ordering::Relaxed);
+        }
+    }
+
